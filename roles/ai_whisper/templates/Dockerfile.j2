FROM intel/oneapi-basekit:latest

RUN apt-get update && apt-get install -y \
    git cmake ffmpeg libsdl2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN git clone https://github.com/ggml-org/whisper.cpp.git .

RUN cmake -B build \
    -DCMAKE_C_COMPILER=icx \
    -DCMAKE_CXX_COMPILER=icpx \
    -DWHISPER_FFMPEG=ON \
    -DWHISPER_SDL2=ON \
    -DGGML_VULKAN=1

RUN cmake --build build -j --config Release

# Note: Model fetching is usually done prior to runtime or mapped via volume.
# This downloads tiny.en as a fallback built-in.
RUN ./models/download-ggml-model.sh tiny.en

ENTRYPOINT ["./build/bin/whisper-server"]
CMD ["--host", "0.0.0.0", "--port", "8080", "-m", "models/ggml-tiny.en.bin"]
