[Unit]
Description=Langfuse Web and API
After=ai-postgres.service ai-clickhouse.service network-online.target

[Container]
Image=docker.io/langfuse/langfuse:latest
Network=ai-net.network
EnvironmentFile=/opt/ai/config/langfuse.env
# Map to host if needed, or rely on a reverse proxy in ai-net
PublishPort=3000:3000

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
