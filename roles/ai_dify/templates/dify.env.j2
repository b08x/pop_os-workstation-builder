# Managed by Ansible
# DB Connections
DB_USERNAME=postgres
DB_PASSWORD={{ vault_postgres_password | default(change_me_in_vault) }}
DB_HOST=ai-postgres
DB_PORT=5432
DB_DATABASE=postgres

# Redis
REDIS_HOST=ai-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
SECRET_KEY={{ vault_dify_secret_key | default(generate_a_secret) }}

# Dify Services Resolvable inside ai-net
API_URL=http://dify-api:5001
CONSOLE_API_URL=http://dify-api:5001
APP_API_URL=http://dify-api:5001
